# Environment variables for Music and You project
# Copy this file to .env and fill in your actual API credentials

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=music_and_you
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# Spotify API (get from https://developer.spotify.com/)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://localhost:8080/callback

# Last.fm API (get from https://www.last.fm/api)
LASTFM_API_KEY=your_lastfm_api_key_here
LASTFM_SECRET=your_lastfm_secret_here

# YouTube Data API (get from Google Cloud Console)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Application settings
LOG_LEVEL=INFO
DATA_DIR=data/
CACHE_TTL=3600

# Model settings
MODEL_RANDOM_STATE=42
MODEL_TEST_SIZE=0.2
MODEL_CV_FOLDS=5

# Development settings
FLASK_ENV=development
DEBUG=True
